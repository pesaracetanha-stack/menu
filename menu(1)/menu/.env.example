# GitiArts Menu Platform - نمونه متغیرهای محیطی
# این فایل را کپی کنید به .env و مقادیر واقعی را وارد کنید
# هرگز .env را در git کامیت نکنید

DEPLOYMENT_MODE=platform

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tehran
APP_KEY=

SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE=
SMS_TEMPLATE_WELCOME=
SMS_TEMPLATE_EXPIRY=
SMS_TEMPLATE_EXPIRED=

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

BASE_URL=https://gitiarts.ir
UPDATE_SERVER=https://gitiarts.ir/updates

DATA_PATH=./data
