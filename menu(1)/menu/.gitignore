# ==========================================
# GitiArts — .gitignore
# ==========================================

# ۱. فایل‌های حساس و تنظیمات
config.php
.env
.env.*

# ۲. دیتابیس‌های کافه‌ها و داده‌های پلتفرم
data/*.json
data/*.sqlite
data/*.db
data/avatars/
data/exports/
data/ticket-files/
tenants/*/data/
tenants/*/uploads/

# ۳. فایل‌های موقت توسعه
_*.php
*.bak.*
*.log
*.zip
*.sqlite
phpinfo.php
.codesaver/

# ۴. سیستم‌عامل و ادیتور
.DS_Store
Thumbs.db
.idea/
.vscode/