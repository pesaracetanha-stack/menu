# ============================================================
# GitiArts Menu Platform - Phase 2 Environment Configuration
# ============================================================
# Copy this file to .env and adjust values.
# Every key here has a documented default; missing keys fall back
# to defaults defined in src/Support/Env.php

# ---------- Deployment Mode ----------
# platform  = multi-tenant SaaS (hosted by us)
# standalone = single café self-hosted installation
DEPLOYMENT_MODE=platform

# ---------- Storage Driver ----------
# sqlite   = one file per tenant (current)
# postgres = schema-per-tenant (future, target at 500+ tenants)
TENANT_STORAGE_DRIVER=sqlite

# ---------- SQLite Storage ----------
# Root directory for tenant data files. Hash-based sub-paths are
# generated automatically (e.g. /a1/b2/c3/{uuid}/data.sqlite)
SQLITE_STORAGE_ROOT=/storage/tenants

# ---------- PostgreSQL Storage (Future) ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=gitiarts
PG_USERNAME=gitiarts_app
PG_PASSWORD=change_me_in_production
PG_CHARSET=utf8
PG_SCHEMA_PREFIX=tenant_

# ---------- Tenant Resolution ----------
# subdomain = miran.platform.ir -> slug "miran"
# path      = platform.ir/t/miran -> slug "miran"
TENANT_RESOLUTION_STRATEGY=subdomain
PLATFORM_BASE_DOMAIN=platform.ir
TENANT_PATH_PREFIX=/t/

# ---------- Cache (Redis optional, file fallback) ----------
CACHE_DRIVER=file
CACHE_ROOT=/storage/cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL_SECONDS=300

# ---------- Localization ----------
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tehran

# ---------- Export Settings ----------
EXPORT_TEMP_ROOT=/storage/exports
EXPORT_ENCRYPTION_ENABLED=false
EXPORT_ENCRYPTION_KEY=

# ---------- Update Channel (Standalone mode) ----------
UPDATE_SERVER_URL=https://api.yourplatform.ir/updates/check
UPDATE_CHECK_INTERVAL_HOURS=24
UPDATE_LICENSE_KEY=
UPDATE_VERIFY_SIGNATURE=true
UPDATE_PUBLIC_KEY=

# ---------- Security ----------
APP_KEY=base64:CHANGE_ME_32_BYTES_BASE64_ENCODED
HASH_ALGO=sha256

# ---------- SMS (Persian OTP providers) ----------
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER_NUMBER=

# ---------- Database Migration Lock ----------
MIGRATION_DUAL_WRITE=false
MIGRATION_VERIFY_ONLY=false
